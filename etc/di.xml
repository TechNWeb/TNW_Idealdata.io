<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Api\CustomerRepositoryInterface">
        <plugin name="tnw_idealdata_customertype_plugin" type="TNW\Idealdata\Plugin\CustomerRepositoryPlugin"/>
        <plugin name="tnw_idealdata_address_updated_at_filter" type="TNW\Idealdata\Plugin\Customer\AddressUpdatedAtFilterPlugin" sortOrder="20"/>
    </type>

    <!-- Product: stock_item, source_items, manage_stock, stock updated_at filter -->
    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="tnw_idealdata_stock_item" type="TNW\Idealdata\Plugin\Product\StockItemPlugin" sortOrder="10"/>
        <plugin name="tnw_idealdata_stock_updated_at_filter" type="TNW\Idealdata\Plugin\Product\StockUpdatedAtFilterPlugin" sortOrder="20"/>
    </type>

    <!-- Cart attributes -->
    <type name="Magento\Quote\Api\CartRepositoryInterface">
        <plugin name="tnw_idealdata_cart_attributes" type="TNW\Idealdata\Plugin\Cart\AddCartAttributesPlugin" sortOrder="10"/>
        <plugin name="tnw_idealdata_cart_item_attributes" type="TNW\Idealdata\Plugin\Cart\AddCartItemAttributesPlugin" sortOrder="20"/>
    </type>

    <!-- Admin order creation: record source cart (Cart A → Cart B lineage) -->
    <type name="Magento\Sales\Model\AdminOrder\Create">
        <plugin name="tnw_idealdata_record_source_cart" type="TNW\Idealdata\Plugin\AdminOrder\RecordSourceCartPlugin" sortOrder="10"/>
    </type>

    <!--
        Adds the CONFIGURED pixel origins to the storefront CSP header, so a store
        provisioned with a non-canonical loader/ingest URL (staging, a legacy CDN
        hostname) is whitelisted without a module release. The canonical origins
        ship statically in etc/csp_whitelist.xml.

        MUST stay in this GLOBAL di.xml, next to where Magento_Csp declares the
        argument. Magento merges object-manager arguments across scopes with
        array_replace() keyed by ARGUMENT NAME (Magento\Framework\ObjectManager\
        Config\Config::_mergeConfiguration), not by array item: declaring
        `collectors` from etc/frontend/di.xml REPLACES core's whole array, leaving
        PixelPolicyCollector as the storefront's ONLY collector. That drops the
        config collector ('self'/'unsafe-inline'/data: defaults), the
        csp_whitelist.xml collector (every merchant host — and this module's own
        whitelist) and the dynamic collector (the per-request nonce), collapsing
        the storefront policy to the three IdealData origins and blocking every
        store script, image and XHR. Item names merge only WITHIN one scope, which
        is what this global declaration relies on.

        Core wires config=1, whitelist=2, dynamic=3, controller=100; sortOrder 15
        places this after the merchant's own csp_whitelist.xml and before
        controller-level overrides. \Proxy matches how core wires its collectors
        (the header is not built on every request). Global scope means every area
        instantiates it, so the collector itself is gated to the frontend area.
    -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="tnw_idealdata_pixel" xsi:type="object" sortOrder="15">TNW\Idealdata\Model\Csp\PixelPolicyCollector\Proxy</item>
            </argument>
        </arguments>
    </type>

    <!-- Preferences -->
    <preference for="TNW\Idealdata\Api\OrderStatusRepositoryInterface" type="TNW\Idealdata\Model\OrderStatusRepository"/>

    <preference for="TNW\Idealdata\Api\FailedTransactionRepositoryInterface" type="TNW\Idealdata\Model\FailedTransactionRepository"/>
    <preference for="TNW\Idealdata\Api\Data\FailedTransactionSearchResultsInterface" type="TNW\Idealdata\Model\Data\FailedTransactionSearchResults"/>

    <preference for="TNW\Idealdata\Api\PixelConfigManagementInterface" type="TNW\Idealdata\Model\PixelConfigManagement"/>
    <preference for="TNW\Idealdata\Api\Data\PixelConfigResultInterface" type="TNW\Idealdata\Model\Data\PixelConfigResult"/>
    <preference for="TNW\Idealdata\Api\Data\PixelConfigStateInterface" type="TNW\Idealdata\Model\Data\PixelConfigState"/>
</config>
