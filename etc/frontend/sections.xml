<?xml version="1.0"?>
<!--
    Declares the IdealData storefront-pixel identity customer-data section.

    The section is invalidated on customer login and logout (the same standard
    actions Magento uses to invalidate the stock `customer` section), so that
    after either event Magento's `Magento_Customer/js/customer-data` reloads it
    via the `/customer/section/load` AJAX endpoint. Because that load happens
    AFTER Full Page Cache, the section is depersonalization-safe by construction
    — this is the whole reason the pixel reads identity from a customer-data
    section instead of inline PHP (which FPC strips on cacheable pages).

    The section name `tnw-idealdata-identity` is ALSO the key under which the
    data lands in localStorage['mage-cache-storage'] — the storefront pixel SDK
    reads `mage-cache-storage['tnw-idealdata-identity'].customer_id`. Do not
    rename it without updating the SDK adapter (cross-repo contract).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="customer/account/login">
        <section name="tnw-idealdata-identity"/>
    </action>
    <action name="customer/account/logout">
        <section name="tnw-idealdata-identity"/>
    </action>
</config>
