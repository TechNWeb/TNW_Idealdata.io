<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi/etc/webapi.xsd">
    <route url="/V1/order/status" method="GET">
        <service class="TNW\Idealdata\Api\OrderStatusRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Magento_Sales::sales"/>
        </resources>
    </route>

    <!-- Failed transactions -->
    <route url="/V1/tnw/carts/failed-transactions" method="GET">
        <service class="TNW\Idealdata\Api\FailedTransactionRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="TNW_Idealdata::failed_transactions_read"/>
        </resources>
    </route>

    <!-- Storefront pixel config provisioning (pushed by the IdealData app; the
         merchant enters nothing in Magento by hand). ACL-protected write.
         Guarded by the core Magento_Catalog::products resource — which the
         IdealData integration ALREADY holds (product sync + Signal 30 product
         writes both require it) — so provisioning needs no new grant and no
         integration reauthorization. Mirrors this module's existing
         /V1/order/status route reusing the core Magento_Sales::sales resource. -->
    <route url="/V1/tnw-idealdata/pixel-config" method="PUT">
        <service class="TNW\Idealdata\Api\PixelConfigManagementInterface" method="save"/>
        <resources>
            <resource ref="Magento_Catalog::products"/>
        </resources>
    </route>

    <!-- Read side of the provisioning contract: the IdealData app reads the LIVE
         config back to reconcile its stored mirror + heal drift. Same ACL as the
         write (Magento_Catalog::products — already held). The raw token is never
         returned — only tokenPresent + a SHA-256 fingerprint. -->
    <route url="/V1/tnw-idealdata/pixel-config" method="GET">
        <service class="TNW\Idealdata\Api\PixelConfigManagementInterface" method="get"/>
        <resources>
            <resource ref="Magento_Catalog::products"/>
        </resources>
    </route>
</routes>
