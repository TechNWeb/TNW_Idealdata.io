<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="idealdata_tab" translate="label" sortOrder="100" class="ideadata-tab">
            <label>IDEALDATA.IO</label>
        </tab>
        <section id="integration_section" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Integration</label>
            <tab>idealdata_tab</tab>
            <resource>TNW_Idealdata::config</resource>
            <group id="introduction_group" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\Intro</frontend_model>
            </group>
            <group id="onboarding_group" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\Onboarding</frontend_model>
            </group>
            <group id="support_group" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\Support</frontend_model>
            </group>
        </section>
        <section id="tnw_idealdata_pixel" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Storefront Pixel</label>
            <tab>idealdata_tab</tab>
            <resource>TNW_Idealdata::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Storefront Pixel</label>
                <comment><![CDATA[Injects the IdealData storefront pixel so logged-in customers report "online now" presence. <strong>These values are managed automatically by the IdealData app</strong> — enable the pixel on your Adobe Commerce connection there and the token + URLs below are delivered to this store for you. The fields are read-only; you do not need to edit them.]]></comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Pixel</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\ReadOnlyField</frontend_model>
                    <comment>Managed automatically by the IdealData app; do not edit. Reflects whether the app has enabled the pixel for this store.</comment>
                </field>
                <field id="ingest_base_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ingest Base URL</label>
                    <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\ReadOnlyField</frontend_model>
                    <comment>Managed automatically by the IdealData app; do not edit. Full ingest base URL including the /pixel-ingest prefix.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="loader_url" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Loader URL</label>
                    <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\ReadOnlyField</frontend_model>
                    <comment>Managed automatically by the IdealData app; do not edit. Full URL to the pixel loader script.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="token" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pixel Token</label>
                    <frontend_model>TNW\Idealdata\Block\Adminhtml\System\Config\ReadOnlyField</frontend_model>
                    <comment>Managed automatically by the IdealData app; do not edit. The opaque pixel token (starts with idpx_) delivered for this store's connection. Exposed to storefront JavaScript by design; not a secret.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
